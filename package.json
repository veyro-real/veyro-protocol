{
  "name": "veyro-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/sdk",
    "test": "node --import tsx --test tests/*.test.ts",
    "bootstrap": "node --import tsx scripts/bootstrap.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "verify:chain": "node --import tsx scripts/verify-chain.ts",
    "build:onchain": "cargo build-sbf --manifest-path programs/veyro/Cargo.toml",
    "test:localnet": "node --import tsx scripts/test-localnet.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.9",
    "@types/node": "22.20.1"
  }
}
